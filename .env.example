# Local Celery broker (start Redis before the worker)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SITE_BASE_URL=http://127.0.0.1:8000

# Stripe test mode only. Configure secrets in Render's environment settings,
# never commit real secrets. Webhook endpoint: /payments/stripe/webhook/
STRIPE_SECRET_KEY=replace_with_sk_test_key
STRIPE_WEBHOOK_SECRET=replace_with_whsec_secret
STRIPE_CURRENCY=INR

# SMTP example; replace with credentials stored outside source control
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CineTrail Tickets <tickets@example.com>
